        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "require": {
        "php": "~8.3 || ~8.4 || ~8.5 || ~8.6"
    },
    "require-dev": {
        "psalm/plugin-phpunit": "^0.19.7",
        "roave/infection-static-analysis-plugin": "^1.43",
        "vimeo/psalm": "^6.18.0"
    },
    "conflict": {
        "psalm/plugin-phpunit": "^0.20.0"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\i18n\\": "../../src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\i18n\\": "../../test/"
        }
    }
}
